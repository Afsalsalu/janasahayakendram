# Django
SECRET_KEY=replace-with-a-long-random-value
DEBUG=False
ALLOWED_HOSTS=example.com,localhost

# Database
DB_ENGINE=django.db.backends.mysql
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=replace-with-database-password
DB_HOST=127.0.0.1
DB_PORT=3306

# SMTP email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_USE_TLS=True
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=replace-with-smtp-password

# Transactional email provider
BREVO_API_KEY=replace-with-brevo-api-key

# Payment provider
RAZORPAY_KEY_ID=replace-with-razorpay-key-id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret

# Document processing and CAPTCHA
PSPDFKIT_API_KEY=replace-with-pspdfkit-api-key
RECAPTCHA_SITE_KEY=replace-with-recaptcha-site-key
RECAPTCHA_SECRET_KEY=replace-with-recaptcha-secret-key
MAPBOX_ACCESS_TOKEN=replace-with-mapbox-access-token

